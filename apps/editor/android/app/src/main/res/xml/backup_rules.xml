<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower apply these rules to cloud backup and device transfer alike. -->
<full-backup-content>
    <exclude domain="sharedpref" path="babylonslate-secrets.xml" />
    <!-- Projects can exceed the 25 MB cloud quota, which would stop every backup. -->
    <exclude domain="file" path="Projects/" />
    <!-- Derived data (thumbnails, recovery journals, traces) belongs to those projects, which are not backed up either. -->
    <exclude domain="file" path="Haptic/" />
</full-backup-content>
