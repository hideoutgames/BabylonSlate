{
  "name": "editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter player build && vite",
    "build": "pnpm --filter player build && tsc -b && vite build",
    "test": "vitest run --config ../../vitest.workspace.ts --project jsdom apps/editor",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "ios:sync": "pnpm build && pnpm exec cap sync ios && node scripts/ios-sync.mjs",
    "ios:build": "pnpm run ios:sync && IOS_SIMULATOR_ID=\"${IOS_SIMULATOR_ID:-$(DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode_16.4.app/Contents/Developer} xcrun simctl list devices available | awk '/iPad/{print}' | grep -Eo '[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}' | head -1)}\" && test -n \"$IOS_SIMULATOR_ID\" && DEVELOPER_DIR=\"${DEVELOPER_DIR:-/Applications/Xcode_16.4.app/Contents/Developer}\" xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Debug -destination \"id=$IOS_SIMULATOR_ID\" CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonslate/anim-graph": "workspace:*",
    "@babylonslate/behaviour-tree": "workspace:*",
    "@babylonslate/assets": "workspace:*",
    "@babylonslate/bridge": "workspace:*",
    "@babylonslate/core": "workspace:*",
    "@babylonslate/debugger": "workspace:*",
    "@babylonslate/edit": "workspace:*",
    "@babylonslate/editor-kit": "workspace:*",
    "@babylonslate/exporter": "workspace:*",
    "@babylonslate/graph-ui": "workspace:*",
    "@babylonslate/input": "workspace:*",
    "@babylonslate/navigation": "workspace:*",
    "@babylonslate/object-model": "workspace:*",
    "@babylonslate/physics": "workspace:*",
    "@babylonslate/render": "workspace:*",
    "@babylonslate/runtime": "workspace:*",
    "@babylonslate/scripting": "workspace:*",
    "@babylonslate/scripting-nodes": "workspace:*",
    "@babylonslate/shader-graph": "workspace:*",
    "@babylonslate/source-control": "workspace:*",
    "@babylonslate/ui": "workspace:*",
    "@babylonslate/vfs": "workspace:*",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@daniele-rolli/capacitor-scoped-storage": "^0.1.0",
    "CapacitorScopedStorage": "npm:@daniele-rolli/capacitor-scoped-storage@^0.1.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.0.14",
    "dockview-react": "^8.0.0",
    "lucide-react": "^0.487.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.14"
  },
  "devDependencies": {
    "@babylonslate/test-kit": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fflate": "^0.8.3",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.2",
    "vite": "^8.2.0"
  }
}
