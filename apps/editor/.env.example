# Optional on web/desktop; required for account access in native mobile apps.
# Leave empty for guest access on web/desktop. Native mobile stays at setup help.
# Obtain a publishable key from your Clerk application's API Keys page.
# Electron/iOS/Android: enable Native API and email-code sign-in/sign-up in Clerk.
# See .agents/reference/architecture/accounts.md for supported flows and token storage.
# Never put a Clerk secret key in Vite client environment variables.
# Distribution builds use the GitHub repository variable of the same name;
# without it, Android/iPadOS builds offer only the temporary demo account.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk Billing plan slug for Haptic Pro on web and desktop (default "pro").
VITE_CLERK_PRO_PLAN_SLUG=
# RevenueCat public SDK keys for the App Store and Google Play builds, and the
# entitlement that unlocks Haptic Pro (default "pro"). Without a key, the
# Subscription page says in-app purchases are not set up for the build.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
VITE_REVENUECAT_PRO_ENTITLEMENT=
