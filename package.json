{
  "name": "haptic",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:wait": "node scripts/agent-wait.mjs",
    "test:agent-wait": "node scripts/run-tests.mjs tooling scripts/agent-wait.test.mjs",
    "test:distribution": "node scripts/run-tests.mjs tooling scripts/distribution/*.test.mjs",
    "dev": "pnpm --filter editor dev",
    "docs:dev": "pnpm --filter docs-site dev",
    "build": "node scripts/run-tests.mjs build-all",
    "build:pages": "VITE_BASE_PATH=/BabylonSlate/ VITE_TEST_MODE=false pnpm --filter editor build && VITEPRESS_BASE=/BabylonSlate/docs/ pnpm --filter docs-site build && mkdir -p apps/editor/dist/docs && cp -a apps/docs/.vitepress/dist/. apps/editor/dist/docs/",
    "typecheck": "node scripts/run-tests.mjs typecheck",
    "lint": "node scripts/run-tests.mjs lint",
    "lint:promises": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js -c eslint.promises.config.js --no-cache packages/runtime/src packages/vfs/src apps/editor/src/services",
    "test": "node scripts/run-tests.mjs unit",
    "test:editor-unit": "node scripts/run-tests.mjs editor",
    "test:coverage": "node scripts/run-tests.mjs coverage",
    "test:watch": "node scripts/run-tests.mjs watch",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:e2e:webkit": "node scripts/run-tests.mjs e2e --config playwright.webkit.config.ts",
    "verify": "node scripts/run-tests.mjs verify",
    "test:tooling": "node scripts/run-tests.mjs tooling",
    "test:resources": "node scripts/test-resources.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "test:build": "node scripts/run-tests.mjs build",
    "test:benchmark": "node scripts/benchmark-tests.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.3.0",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.12",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.3"
}
