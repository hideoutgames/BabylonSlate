{
  "name": "babylonslate",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:wait": "node scripts/agent-wait.mjs",
    "test:agent-wait": "node scripts/run-tests.mjs tooling scripts/agent-wait.test.mjs",
    "dev": "pnpm --filter editor dev",
    "docs:dev": "pnpm --filter docs-site dev",
    "build": "node scripts/run-tests.mjs build-all",
    "build:pages": "VITE_BASE_PATH=/BabylonSlate/ VITE_TEST_MODE=true pnpm --filter editor build && VITEPRESS_BASE=/BabylonSlate/docs/ pnpm --filter docs-site build && mkdir -p apps/editor/dist/docs && cp -a apps/docs/.vitepress/dist/. apps/editor/dist/docs/",
    "typecheck": "node scripts/run-tests.mjs typecheck",
    "lint": "node scripts/run-tests.mjs lint",
    "test": "node scripts/run-tests.mjs unit",
    "test:editor-unit": "node scripts/run-tests.mjs editor",
    "test:coverage": "node scripts/run-tests.mjs coverage",
    "test:watch": "node scripts/run-tests.mjs watch",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "verify": "node scripts/run-tests.mjs verify",
    "test:tooling": "node scripts/run-tests.mjs tooling",
    "verify:local": "node scripts/verify-local.mjs",
    "test:build": "node scripts/run-tests.mjs build",
    "test:benchmark": "node scripts/benchmark-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.0.0",
    "coi-serviceworker": "^0.1.7",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^4.3.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^4.0.0",
    "zod": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.3"
}
